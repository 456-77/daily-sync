# .env.example —— 复制为 .env 并填入真实值；.env 永远不提交
# 本机开发（M1~M5 用法）：只有 DB_PASSWORD/JWT_SECRET/INVITE_CODE 参与 application.yml 环境变量注入
DB_PASSWORD=change-me
JWT_SECRET=change-me-openssl-rand-hex-32
INVITE_CODE=

# 服务器部署（docker-compose.yml 读取，放在 /opt/daily-sync/.env）
# BEHIND_PROXY=true 时客户端 IP 取 X-Forwarded-For（套反向代理后开启；直连保持 false）
BEHIND_PROXY=false
